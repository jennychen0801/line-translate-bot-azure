# ============================================================
# LINE 群組翻譯機器人 環境變數範本
# 複製成 .env（本機測試用），或直接把每一項填到 Render 的 Environment
# ============================================================

# --- LINE Messaging API（必填） ---
# 來源：LINE Developers Console > 你的 Channel > Messaging API / Basic settings
CHANNEL_ACCESS_TOKEN=你的_LINE_channel_access_token
CHANNEL_SECRET=你的_LINE_channel_secret

# --- Azure OpenAI（主翻，走 VS Enterprise 額度）---
# 來源：Azure Portal > 你的 Azure OpenAI 資源 > Keys and Endpoint / 部署(Deployments)
AZURE_OPENAI_ENDPOINT=https://你的資源名稱.openai.azure.com
AZURE_OPENAI_KEY=你的_azure_openai_key
AZURE_OPENAI_DEPLOYMENT=你的部署名稱          # 例：gpt-5-mini（部署時自訂的 deployment name）
AZURE_OPENAI_API_VERSION=2025-04-01-preview   # 可省略，預設即此值（支援 GPT-5 系列）

# --- Gemini（備援；Azure 失敗時自動頂上，免費層即可）---
# 來源：Google AI Studio (https://aistudio.google.com) > Get API key
GEMINI_API_KEY=你的_gemini_api_key
GEMINI_MODEL=gemini-3.1-flash-lite            # 可省略，預設即此值

# --- 線上診斷（可選）：設定後可用 /debug/translate?token=... 測翻譯引擎 ---
DEBUG_TOKEN=隨便一串長亂碼

# --- 伺服器 Port（Render 會自動注入，本機測試可用 3000） ---
PORT=3000
